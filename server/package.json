{
  "name": "freshman-qa-server",
  "version": "1.0.0",
  "description": "冰冰快答小助手 - 无锡学院新生问答系统",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node --test test/api.test.js test/db.test.js test/env.test.js test/rateLimit.test.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop qa-server",
    "pm2:restart": "pm2 restart qa-server",
    "pm2:logs": "pm2 logs qa-server",
    "cache:flush": "node scripts/flush_cache.js",
    "kb:init": "node scripts/init_kg.js",
    "lint": "eslint . --ext .js"
  },
  "keywords": ["qa", "chatbot", "university", "wechat-miniapp"],
  "author": "杨健斌",
  "license": "ISC",
