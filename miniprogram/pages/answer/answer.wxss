.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.content {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx 22rpx 40rpx;
}

.count-line {
  margin-bottom: 16rpx;
  color: var(--ink-muted);
  font-size: var(--font-sm);
}

/* 骨架卡片 */
.q-card.skel-card {
  border-left: none;
}

.skel-line {
  height: 26rpx;
  margin-bottom: 16rpx;
}

.skel-line.w40 { width: 40%; }
.skel-line.w90 { width: 90%; }
.skel-line.w60 { width: 60%; margin-bottom: 0; }

/* 空态/错误态 */
.retry-btn {
  margin-top: 28rpx;
  padding: 0 48rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  border-radius: var(--radius-pill);
  font-size: var(--font-sm);
}

.q-card {
  padding: 25rpx;
  margin-bottom: 16rpx;
  background: var(--surface);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
  transition: transform 0.16s var(--ease);
}

.q-card:active {
  transform: scale(0.985);
}

.q-top,
.q-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.q-top {
  margin-bottom: 13rpx;
}

.q-category {
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 7rpx 15rpx;
  border-radius: var(--radius-pill);
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 21rpx;
  font-weight: 600;
}

.q-time {
  flex-shrink: 0;
  color: var(--ink-muted);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.q-text {
  display: block;
  margin-bottom: 18rpx;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.5;
}

.q-bottom {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.q-asker {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink-muted);
  font-size: 23rpx;
}

.q-action {
  flex-shrink: 0;
  color: var(--primary-strong);
  font-size: var(--font-sm);
  font-weight: 600;
}

/* 回答弹窗（底部弹层） */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background: var(--mask);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s var(--ease);
}

.modal-mask.on {
  opacity: 1;
  pointer-events: auto;
}

.answer-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  background: var(--surface);
  border-radius: 28rpx 28rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.24s var(--ease);
  padding-bottom: env(safe-area-inset-bottom);
}

.answer-modal.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid var(--line);
}

.modal-title {
  font-size: var(--font-lg);
  font-weight: 700;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-muted);
  color: var(--ink-muted);
  font-size: 34rpx;
}

.modal-close:active {
  opacity: 0.7;
}

.modal-question {
  flex-shrink: 0;
  padding: 22rpx 30rpx;
  background: var(--primary-soft);
}

.q-label {
  display: block;
  color: var(--ink-muted);
  font-size: var(--font-xs);
  font-weight: 600;
}

.q-body {
  display: block;
  margin-top: 8rpx;
  color: var(--ink);
  font-size: var(--font-md);
  font-weight: 600;
  line-height: 1.5;
}

.modal-body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx 30rpx;
}

.answer-input {
  width: 100%;
  height: 230rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--bg);
  font-size: var(--font-md);
  line-height: 1.55;
}

.char-count {
  display: block;
  margin-top: 8rpx;
  text-align: right;
  color: var(--ink-muted);
  font-size: 21rpx;
  font-variant-numeric: tabular-nums;
}

.modal-footer {
  display: flex;
  gap: 18rpx;
  flex-shrink: 0;
  padding: 18rpx 30rpx 28rpx;
}

.modal-btn {
  flex: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  font-size: var(--font-md);
  font-weight: 600;
  transition: transform 0.16s var(--ease);
}

.modal-btn:active {
  transform: scale(0.97);
}

.modal-btn.cancel {
  background: var(--surface-muted);
  color: var(--ink-secondary);
}
