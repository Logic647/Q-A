.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-shrink: 0;
  min-height: 104rpx;
  box-sizing: border-box;
  padding: calc(76rpx + env(safe-area-inset-top)) 22rpx 18rpx;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1rpx solid var(--line);
}

.header-left {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: var(--surface-muted);
}

.back-icon {
  color: var(--ink-secondary);
  font-size: 34rpx;
}

.header-title {
  flex: 1;
  color: var(--ink);
  font-size: 33rpx;
  font-weight: 700;
}

.header-count {
  flex-shrink: 0;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 23rpx;
  font-weight: 600;
}

.content {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx 22rpx 40rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: var(--surface-muted);
  color: var(--ink-muted);
  font-size: 36rpx;
  font-weight: 700;
}

.empty-text {
  color: var(--ink-secondary);
  font-size: 30rpx;
  font-weight: 600;
}

.empty-sub {
  margin-top: 8rpx;
  color: var(--ink-muted);
  font-size: 24rpx;
}

.q-card {
  padding: 25rpx;
  margin-bottom: 16rpx;
  background: var(--surface);
  border-left: 5rpx solid var(--primary);
  border-radius: 14rpx;
  box-shadow: var(--shadow-sm);
}

.q-card:active {
  background: #fbfdfc;
}

.q-top,
.q-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.q-top {
  margin-bottom: 13rpx;
}

.q-category {
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 21rpx;
  font-weight: 600;
}

.q-time {
  flex-shrink: 0;
  color: var(--ink-muted);
  font-size: 21rpx;
}

.q-text {
  display: block;
  margin-bottom: 18rpx;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.5;
}

.q-bottom {
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
}

.q-asker {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink-muted);
  font-size: 23rpx;
}

.q-action {
  flex-shrink: 0;
  color: var(--primary-strong);
  font-size: 24rpx;
  font-weight: 600;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(17, 24, 39, 0.45);
}

.answer-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  max-height: 82vh;
  background: var(--surface);
  border-radius: 16rpx 16rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.answer-modal.show {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--line);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-muted);
  color: var(--ink-muted);
  font-size: 34rpx;
}

.modal-question {
  flex-shrink: 0;
  padding: 22rpx 30rpx;
  background: var(--bg);
}

.q-label {
  display: block;
  color: var(--ink-muted);
  font-size: 22rpx;
  font-weight: 600;
}

.q-body {
  display: block;
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.modal-body {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx 30rpx;
}

.answer-input {
  width: 100%;
  height: 230rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fbfcfd;
  font-size: 28rpx;
  line-height: 1.55;
}

.char-count {
  display: block;
  margin-top: 8rpx;
  text-align: right;
  color: var(--ink-muted);
  font-size: 21rpx;
}

.modal-footer {
  display: flex;
  gap: 18rpx;
  flex-shrink: 0;
  padding: 18rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
}

.modal-btn {
  flex: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: var(--surface-muted);
  color: var(--ink-secondary);
}

.modal-btn.submit {
  background: #e7eaee;
  color: #a1a7af;
}

.modal-btn.submit.active {
  background: var(--primary);
  color: #fff;
}
