<view class="page">
  <scroll-view class="content" scroll-y>
    <view class="count-line" wx:if="{{pendingList.length > 0}}">共 {{pendingList.length}} 个待回答</view>

    <!-- 加载骨架 -->
    <block wx:if="{{loading}}">
      <view class="q-card skel-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="skel skel-line w40"></view>
        <view class="skel skel-line w90"></view>
        <view class="skel skel-line w60"></view>
      </view>
    </block>

    <!-- 加载失败 -->
    <view class="empty-state" wx:elif="{{loadError}}">
      <view class="empty-icon">!</view>
      <text class="empty-title">加载失败</text>
      <text class="empty-text">{{loadError}}</text>
      <view class="btn-main retry-btn" bindtap="loadPendingQuestions">重新加载</view>
    </view>

    <view class="empty-state" wx:elif="{{pendingList.length === 0}}">
      <view class="empty-icon">空</view>
      <text class="empty-title">暂无待回答问题</text>
      <text class="empty-text">聊天中未被收录的新问题会自动出现在这里</text>
    </view>

    <block wx:else>
      <view class="q-card" wx:for="{{pendingList}}" wx:key="question_id"
            bindtap="onSelectQuestion" data-id="{{item.question_id}}" data-text="{{item.question_text}}">
        <view class="q-top">
          <text class="q-category">{{item.category || '未分类'}}</text>
          <text class="q-time">{{item.created_at}}</text>
        </view>
        <text class="q-text">{{item.question_text}}</text>
        <view class="q-bottom">
          <text class="q-asker">来自：{{item.asker_name || '匿名新生'}}</text>
          <text class="q-action">去回答</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <!-- 回答弹窗 -->
  <view class="modal-mask {{showAnswerModal ? 'on' : ''}}" bindtap="closeModal"></view>
  <view class="answer-modal {{showAnswerModal ? 'show' : ''}}">
    <view class="sheet-handle"></view>
    <view class="modal-header">
      <text class="modal-title">回答问题</text>
      <view class="modal-close" bindtap="closeModal">×</view>
    </view>
    <view class="modal-question">
      <text class="q-label">问题</text>
      <text class="q-body">{{currentQuestion}}</text>
    </view>
    <view class="modal-body">
      <textarea class="answer-input" placeholder="请输入你的回答..." value="{{answerText}}" bindinput="onAnswerInput" maxlength="500"></textarea>
      <text class="char-count">{{answerText.length}}/500</text>
    </view>
    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="closeModal">取消</view>
      <view class="modal-btn submit btn-main {{answerText ? '' : 'disabled'}}" bindtap="submitAnswer">提交回答</view>
    </view>
  </view>
</view>
