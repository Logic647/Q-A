/* === 基础 === */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

/* === 遮罩 === */
.menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 90;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.menu-mask.show {
  opacity: 1;
  pointer-events: auto;
}

/* === 侧边栏 === */
.sidebar {
  position: fixed;
  top: 0;
  left: -520rpx;
  width: 520rpx;
  height: 100vh;
  background: #fff;
  z-index: 100;
  display: flex;
  flex-direction: column;
  box-shadow: 4rpx 0 24rpx rgba(0, 0, 0, 0.08);
  transition: left 0.3s ease;
}
.sidebar.show { left: 0; }

.sidebar-header {
  display: flex;
  align-items: center;
  padding: 120rpx 32rpx 40rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #f0f0f0;
}
.sidebar-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #333;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  margin-right: 20rpx;
}
.sidebar-user { display: flex; flex-direction: column; }
.sidebar-name { font-size: 32rpx; color: #111; font-weight: 600; }
.sidebar-id { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.sidebar-actions { padding: 24rpx 24rpx 0; }
.sidebar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.new-chat { background: #f5f5f5; color: #333; border: 1rpx solid #e5e7eb; }
.btn-icon { font-size: 36rpx; margin-right: 8rpx; }

.sidebar-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  padding: 20rpx 0;
}
.section-title {
  font-size: 22rpx;
  color: #999;
  padding: 0 32rpx 12rpx;
  letter-spacing: 2rpx;
}
.history-list { flex: 1; padding: 0 24rpx; }
.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 4rpx;
}
.history-item:active { background: #f5f5f5; }
.history-content { flex: 1; overflow: hidden; }
.history-title {
  font-size: 28rpx;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.history-time { font-size: 22rpx; color: #bbb; margin-top: 4rpx; display: block; }
.history-del {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #ccc;
  flex-shrink: 0;
}
.history-del:active { color: #ef4444; }
.history-empty { text-align: center; color: #ccc; font-size: 26rpx; padding: 60rpx 0; }

.sidebar-footer {
  border-top: 1rpx solid #f0f0f0;
  padding: 16rpx 24rpx 40rpx;
}
.sidebar-menu-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #555;
}
.sidebar-menu-item:active { background: #f5f5f5; }
.sidebar-menu-item.logout { color: #ef4444; }
.menu-icon { margin-right: 16rpx; font-size: 30rpx; }

/* === 地图浮层 === */
.map-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 110;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}
.map-mask.show { opacity: 1; pointer-events: auto; }

.map-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 58vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 120;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.1);
}
.map-panel.show { transform: translateY(0); }

.map-drag {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}
.map-drag-bar {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e0e0e0;
}

.map-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 32rpx 16rpx;
}
.map-title { font-size: 32rpx; font-weight: 600; color: #111; }
.map-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
  border-radius: 50%;
  background: #f5f5f5;
}
.map-close:active { background: #eee; }

.map-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
}
.map-img { width: 100%; flex: 1; }

.zoom-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 0;
}
.zoom-icon { font-size: 28rpx; }
.zoom-text { font-size: 22rpx; color: #999; }

/* === 主内容 === */
.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100vh;
  position: relative;
}

/* === 浮动菜单按钮 === */
.float-menu {
  position: fixed;
  top: 120rpx;
  left: 24rpx;
  z-index: 50;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}
.float-menu:active { background: #f0f0f0; }
.menu-icon-text { font-size: 36rpx; color: #333; }

/* === 消息列表 === */
.msg-list {
  flex: 1;
  padding: 20rpx;
  background: #f5f5f5;
  overflow-y: auto;
}

.msg-row {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
}
.msg-row.user { flex-direction: row-reverse; }

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #fff;
  flex-shrink: 0;
  margin: 0 12rpx;
}
.msg-avatar.bot { background: #333; }
.msg-avatar.user { background: #e5e7eb; color: #333; }

.msg-content {
  max-width: 70%;
}
.msg-row.user .msg-content { text-align: right; }

.msg-bubble {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
  white-space: pre-wrap;
  background: #fff;
  color: #333;
  display: inline-block;
  max-width: 100%;
}
.msg-bubble.bot {
  border-top-left-radius: 4rpx;
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}
.msg-bubble.user {
  background: #f0f0f0;
  color: #111;
  border-top-right-radius: 4rpx;
}

.msg-time {
  font-size: 20rpx;
  color: #ccc;
  margin-top: 6rpx;
  padding: 0 8rpx;
}
.msg-time.user { text-align: right; }

/* === 欢迎语 === */
.welcome-msg {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
}

/* === 加载动画 === */
.loading-bubble {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 32rpx;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ccc;
  animation: blink 1.4s infinite;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; }
  40% { opacity: 1; }
}

/* === 评分条 === */
.feedback-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
  padding: 0 8rpx;
}
.feedback-label { font-size: 22rpx; color: #bbb; }
.feedback-btns { display: flex; gap: 8rpx; }
.fbtn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 28rpx;
  background: #f5f5f5;
}
.fbtn.active { background: #e5e7eb; }
.fbtn:active { transform: scale(1.1); }

/* === 快捷提问 === */
.quick-bar {
  padding: 12rpx 0 8rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.quick-scroll { white-space: nowrap; padding: 0 16rpx; }
.quick-chip {
  display: inline-block;
  padding: 14rpx 28rpx;
  margin: 0 8rpx;
  background: #fff;
  color: #555;
  border-radius: 32rpx;
  font-size: 26rpx;
  border: 1rpx solid #e5e7eb;
}
.quick-chip:active {
  background: #f5f5f5;
  color: #111;
  border-color: #ccc;
}

/* === 输入栏 === */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}
.input-left {
  padding: 12rpx 16rpx 12rpx 4rpx;
  display: flex;
  align-items: center;
}
.map-icon { font-size: 40rpx; }
.input-field {
  flex: 1;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
}
.send-btn {
  margin-left: 16rpx;
  padding: 18rpx 36rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #ccc;
  background: #f0f0f0;
  font-weight: 500;
}
.send-btn.active {
  background: #333;
  color: #fff;
}
.send-btn:active { opacity: 0.85; }
