.chat-container { display: flex; flex-direction: column; height: 100vh; background: #f5f5f5; }

.msg-list { flex: 1; padding: 20rpx; overflow-y: auto; }

.msg-row { display: flex; margin-bottom: 24rpx; align-items: flex-start; }
.msg-row.user { flex-direction: row-reverse; }

.avatar { width: 72rpx; height: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: bold; color: #fff; flex-shrink: 0; }
.bot-avatar { background: #2563eb; }
.user-avatar { background: #22c55e; }

.bubble { max-width: 70%; padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 28rpx; line-height: 1.7; position: relative; word-break: break-all; }
.bot-bubble { background: #fff; color: #333; border-top-left-radius: 4rpx; margin-left: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); }
.user-bubble { background: #2563eb; color: #fff; border-top-right-radius: 4rpx; margin-right: 16rpx; }

.bubble-time { font-size: 20rpx; color: #999; margin-top: 8rpx; }
.user-bubble .bubble-time { color: rgba(255,255,255,0.7); text-align: right; }

.loading-bubble { display: flex; align-items: center; gap: 8rpx; padding: 24rpx 32rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #999; animation: blink 1.4s infinite; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%,80%,100% { opacity: 0.3; } 40% { opacity: 1; } }

.quick-ask { padding: 12rpx 0; background: #fff; border-top: 1rpx solid #eee; }
.quick-scroll { white-space: nowrap; padding: 0 16rpx; }
.quick-item { display: inline-block; padding: 12rpx 24rpx; margin-right: 16rpx; background: #eff6ff; color: #2563eb; border-radius: 24rpx; font-size: 24rpx; border: 1rpx solid #bfdbfe; }

.input-bar { display: flex; align-items: center; padding: 16rpx 20rpx; background: #fff; border-top: 1rpx solid #eee; }
.input-box { flex: 1; background: #f5f5f5; border-radius: 32rpx; padding: 16rpx 24rpx; font-size: 28rpx; }
.send-btn { margin-left: 16rpx; padding: 16rpx 32rpx; border-radius: 32rpx; font-size: 28rpx; color: #999; background: #f0f0f0; }
.send-btn.active { background: #2563eb; color: #fff; }
