.chat-page {
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
}

.menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(17, 24, 39, 0.42);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.24s ease;
}

.menu-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.sidebar {
  position: fixed;
  top: 0;
  left: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  width: 80vw;
  max-width: 620rpx;
  height: 100vh;
  background: var(--surface);
  transform: translateX(-100%);
  transition: transform 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
  box-shadow: 10rpx 0 36rpx rgba(17, 24, 39, 0.12);
}

.sidebar.show {
  transform: translateX(0);
}

.sidebar-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 34rpx 30rpx;
  border-bottom: 1rpx solid var(--line);
}

.sidebar-avatar {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 14rpx;
  background: var(--primary);
  color: #fff;
  font-size: 35rpx;
  font-weight: 700;
}

.sidebar-user {
  min-width: 0;
}

.sidebar-name,
.sidebar-id {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sidebar-name {
  font-size: 31rpx;
  font-weight: 600;
}

.sidebar-id {
  margin-top: 5rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.sidebar-actions {
  padding: 24rpx 24rpx 12rpx;
}

.new-chat-button {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 12rpx;
  background: var(--primary);
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
}

.new-chat-icon {
  font-size: 32rpx;
}

.sidebar-section {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding-top: 18rpx;
}

.section-title {
  padding: 0 32rpx 12rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
  font-weight: 600;
}

.history-list {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 0 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
  margin-bottom: 8rpx;
  padding: 18rpx 16rpx;
  border-radius: 12rpx;
  transition: background-color 0.15s ease;
}

.history-item:active {
  background: var(--surface-muted);
}

.history-item.active {
  background: var(--primary-soft);
}

.history-content {
  flex: 1;
  min-width: 0;
}

.history-title,
.history-time {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-title {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 500;
}

.history-time {
  margin-top: 4rpx;
  color: var(--ink-muted);
  font-size: 21rpx;
}

.history-del {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  color: var(--ink-muted);
  font-size: 32rpx;
}

.history-del:active {
  background: var(--danger-soft);
  color: var(--danger);
}

.history-empty {
  padding: 56rpx 0;
  text-align: center;
  color: var(--ink-muted);
  font-size: 25rpx;
}

.sidebar-footer {
  padding: 16rpx 20rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--line);
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 13rpx 10rpx;
  border-radius: 12rpx;
  color: var(--ink-secondary);
  font-size: 28rpx;
}

.menu-item:active {
  background: var(--surface-muted);
}

.menu-badge {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 11rpx;
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
}

.menu-badge.primary { background: var(--primary); }
.menu-badge.green { background: var(--success); }
.menu-badge.neutral { background: #667085; }
.menu-badge.danger { background: var(--danger); }

.main {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.chat-topbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1rpx solid var(--line);
}

.icon-button {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: var(--surface-muted);
  color: var(--ink-secondary);
  font-size: 29rpx;
  font-weight: 600;
}

.topbar-copy {
  flex: 1;
  min-width: 0;
}

.topbar-title {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
}

.topbar-subtitle {
  display: block;
  margin-top: 3rpx;
  color: var(--ink-muted);
  font-size: 22rpx;
}

.message-list {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx 20rpx 10rpx;
}

.welcome-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin: 16rpx 4rpx 28rpx;
  padding: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}

.welcome-avatar,
.message-avatar {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 13rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.welcome-avatar,
.message-avatar.bot {
  background: var(--primary);
  color: #fff;
}

.message-avatar.user {
  background: #e7eaee;
  color: var(--ink-secondary);
}

.welcome-copy {
  flex: 1;
  min-width: 0;
}

.welcome-title {
  display: block;
  font-size: 31rpx;
  font-weight: 700;
}

.welcome-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--ink-secondary);
  font-size: 26rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 26rpx;
}

.message-row.user {
  flex-direction: row-reverse;
}

.message-content {
  max-width: 72%;
}

.message-row.user .message-content {
  text-align: right;
}

.message-bubble {
  display: inline-block;
  max-width: 100%;
  box-sizing: border-box;
  padding: 20rpx 23rpx;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
  border-radius: 14rpx;
  background: var(--surface);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.68;
  box-shadow: var(--shadow-sm);
}

.message-bubble.bot {
  border-top-left-radius: 5rpx;
}

.message-bubble.user {
  background: var(--primary);
  color: #fff;
  text-align: left;
  border-top-right-radius: 5rpx;
}

.message-time {
  display: block;
  padding: 6rpx 6rpx 0;
  color: var(--ink-muted);
  font-size: 20rpx;
}

.loading-bubble {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  min-width: 150rpx;
  min-height: 82rpx;
  box-sizing: border-box;
}

.dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #b9c3c9;
  animation: blink 1.3s infinite;
}

.dot:nth-child(2) { animation-delay: 0.18s; }
.dot:nth-child(3) { animation-delay: 0.36s; }

.list-end {
  height: 12rpx;
}

.feedback-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.feedback-label {
  color: var(--ink-muted);
  font-size: 22rpx;
}

.feedback-option {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: var(--surface-muted);
  color: var(--ink-secondary);
  font-size: 21rpx;
}

.feedback-option.negative {
  background: transparent;
  border: 1rpx solid var(--line);
}

.feedback-option:active {
  background: var(--primary-soft);
  color: var(--primary-strong);
}

.quick-bar {
  flex-shrink: 0;
  padding: 14rpx 0 8rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
}

.quick-scroll {
  box-sizing: border-box;
  padding: 0 16rpx;
  white-space: nowrap;
}

.quick-chip {
  display: inline-block;
  margin-right: 12rpx;
  padding: 14rpx 25rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--ink-secondary);
  font-size: 25rpx;
}

.quick-chip:last-child {
  margin-right: 0;
}

.quick-chip:active {
  border-color: var(--primary);
  background: var(--primary-soft);
  color: var(--primary-strong);
}

.input-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
  padding: 15rpx 18rpx calc(15rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid var(--line);
}

.map-button {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 24rpx;
  font-weight: 700;
}

.question-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 25rpx;
  border-radius: 999rpx;
  background: var(--surface-muted);
  font-size: 28rpx;
}

.input-placeholder {
  color: var(--ink-muted);
}

.send-button {
  min-width: 124rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #e6e9ed;
  color: #a1a7af;
  font-size: 27rpx;
  font-weight: 600;
}

.send-button.active {
  background: var(--primary);
  color: #fff;
}

.send-button:active {
  opacity: 0.86;
}

@keyframes blink {
  0%, 80%, 100% { opacity: 0.28; }
  40% { opacity: 1; }
}
