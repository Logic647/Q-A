<view class="page">
  <!-- 侧边栏遮罩 -->
  <view class="menu-mask {{showMenu ? 'show' : ''}}" bindtap="closeMenu"></view>

  <!-- 侧边栏 -->
  <view class="sidebar {{showMenu ? 'show' : ''}}">
    <view class="sidebar-header">
      <view class="sidebar-avatar">{{userInfo.nickname[0] || '我'}}</view>
      <view class="sidebar-user">
        <text class="sidebar-name">{{userInfo.nickname}}</text>
        <text class="sidebar-id">ID: {{userInfo.user_id}}</text>
      </view>
    </view>
    <view class="sidebar-actions">
      <view class="sidebar-btn new-chat" bindtap="startNewConversation">
        <text class="btn-icon">+</text><text>新建对话</text>
      </view>
    </view>
    <view class="sidebar-section">
      <view class="section-title">历史记录</view>
      <scroll-view class="history-list" scroll-y>
        <view class="history-item" wx:for="{{conversations}}" wx:key="id"
              bindtap="switchConversation" data-id="{{item.id}}">
          <view class="history-content">
            <text class="history-title">{{item.title}}</text>
            <text class="history-time">{{item.updatedAt}}</text>
          </view>
          <view class="history-del" catchtap="deleteConversation" data-id="{{item.id}}">×</view>
        </view>
        <view class="history-empty" wx:if="{{conversations.length === 0}}">暂无对话记录</view>
      </scroll-view>
    </view>
    <view class="sidebar-footer">
      <view class="sidebar-menu-item" bindtap="goToAnswer">
        <text class="menu-icon">✏️</text><text>回答问题</text>
      </view>
      <view class="sidebar-menu-item" bindtap="goToVerify">
        <text class="menu-icon">🪪</text><text>身份认证</text>
      </view>
      <view class="sidebar-menu-item" bindtap="goToAdmin">
        <text class="menu-icon">⚙️</text><text>管理后台</text>
      </view>
      <view class="sidebar-menu-item" bindtap="clearAllHistory">
        <text class="menu-icon">🗑️</text><text>清空历史</text>
      </view>
      <view class="sidebar-menu-item logout" bindtap="onLogout">
        <text class="menu-icon">🚪</text><text>退出登录</text>
      </view>
    </view>
  </view>

  <!-- 地图浮层面板 -->
  <view class="map-mask {{showMap ? 'show' : ''}}" bindtap="closeMap"></view>
  <view class="map-panel {{showMap ? 'show' : ''}}">
    <view class="map-drag"><view class="map-drag-bar"></view></view>
    <view class="map-header">
      <text class="map-title">校园地图</text>
      <view class="map-close" bindtap="closeMap"><text>×</text></view>
    </view>
    <scroll-view class="map-scroll" scroll-x scroll-y enhanced show-scrollbar="{{false}}">
      <image class="map-img" src="{{mapUrl}}" mode="widthFix" show-menu-by-longpress />
    </scroll-view>
    <view class="map-tip"><text class="tip-text">双指缩放查看详情 · 长按可保存图片</text></view>
  </view>

  <!-- 主内容区 -->
  <view class="main">
    <!-- 顶栏 -->
    <view class="header">
      <view class="header-left" bindtap="toggleMenu">
        <view class="menu-btn">
          <view class="menu-line"></view>
          <view class="menu-line"></view>
          <view class="menu-line"></view>
        </view>
      </view>
      <view class="header-title">新生助手</view>
      <view class="header-right"></view>
    </view>

    <!-- 消息列表 -->
    <scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollToId}}" enhanced show-scrollbar="{{false}}">
      <!-- 欢迎语 -->
      <view class="welcome-msg" wx:if="{{messages.length === 0 && !loading}}">
        <view class="msg-avatar bot">助</view>
        <view class="msg-content">
          <view class="msg-bubble bot"><text user-select>{{welcomeText}}</text></view>
        </view>
      </view>

      <!-- 消息 -->
      <view class="msg-row {{item.role}}" wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
        <view class="msg-avatar {{item.role === 'bot' ? 'bot' : 'user'}}">
          {{item.role === 'bot' ? '助' : '我'}}
        </view>
        <view class="msg-content">
          <view class="msg-bubble {{item.role === 'bot' ? 'bot' : 'user'}}">
            <text user-select>{{item.text}}</text>
          </view>
          <text class="msg-time {{item.role}}">{{item.time}}</text>
          <!-- 评分条：仅在机器人回答后且未评分时显示 -->
          <view class="feedback-bar" wx:if="{{item.role === 'bot' && !item.rated && item.text.length > 5}}">
            <text class="feedback-label">有帮助吗？</text>
            <view class="feedback-btns">
              <view class="fbtn good {{item.score === 1 ? 'active' : ''}}" catchtap="onFeedback" data-idx="{{index}}" data-score="1">👍</view>
              <view class="fbtn bad {{item.score === -1 ? 'active' : ''}}" catchtap="onFeedback" data-idx="{{index}}" data-score="-1">👎</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 加载 -->
      <view class="msg-row bot" wx:if="{{loading}}" id="msg-loading">
        <view class="msg-avatar bot">助</view>
        <view class="msg-content">
          <view class="msg-bubble bot loading-bubble">
            <view class="dot"></view><view class="dot"></view><view class="dot"></view>
          </view>
        </view>
      </view>

      <view id="msg-bottom" style="height:20rpx;"></view>
    </scroll-view>

    <!-- 快捷提问 -->
    <view class="quick-bar">
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="quick-scroll">
        <view class="quick-chip" wx:for="{{quickQuestions}}" wx:key="*this" bindtap="onQuickAsk" data-text="{{item}}">
          {{item}}
        </view>
      </scroll-view>
    </view>

    <!-- 输入栏 -->
    <view class="input-bar">
      <view class="input-left" bindtap="openMap">
        <text class="map-icon">📍</text>
      </view>
      <input class="input-field" placeholder="输入你的问题..." bindinput="onInput" value="{{inputValue}}" bindconfirm="onSend" confirm-type="send" />
      <view class="send-btn {{inputValue ? 'active' : ''}}" bindtap="onSend"><text>发送</text></view>
    </view>
  </view>
</view>
