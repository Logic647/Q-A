<view class="chat-page">
  <view class="menu-mask {{showMenu ? 'show' : ''}}" bindtap="closeMenu"></view>

  <view class="sidebar {{showMenu ? 'show' : ''}}">
    <view class="sidebar-header">
      <view class="sidebar-avatar">{{userInfo.nickname[0] || '我'}}</view>
      <view class="sidebar-user">
        <text class="sidebar-name">{{userInfo.nickname}}</text>
        <text class="sidebar-id">ID {{userInfo.user_id}}</text>
      </view>
    </view>

    <view class="sidebar-actions">
      <view class="new-chat-button" bindtap="startNewConversation">
        <text class="new-chat-icon">+</text>
        <text>新建对话</text>
      </view>
    </view>

    <view class="sidebar-section">
      <text class="section-title">历史记录</text>
      <scroll-view class="history-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view
          class="history-item {{item.id === currentConversationId ? 'active' : ''}}"
          wx:for="{{conversations}}"
          wx:key="id"
          bindtap="switchConversation"
          data-id="{{item.id}}"
        >
          <view class="history-content">
            <text class="history-title">{{item.title}}</text>
            <text class="history-time">{{item.updatedAt}}</text>
          </view>
          <view class="history-del" catchtap="deleteConversation" data-id="{{item.id}}">×</view>
        </view>
        <view class="history-empty" wx:if="{{conversations.length === 0}}">暂无对话记录</view>
      </scroll-view>
    </view>

    <view class="sidebar-footer">
      <view class="menu-item" bindtap="goToAnswer">
        <view class="menu-badge green">答</view>
        <text>回答问题</text>
      </view>
      <view class="menu-item" bindtap="goToVerify">
        <view class="menu-badge primary">认</view>
        <text>身份认证</text>
      </view>
      <view class="menu-item" bindtap="goToHistory">
        <view class="menu-badge neutral">记</view>
        <text>提问记录</text>
      </view>
      <view class="menu-item" bindtap="clearAllHistory">
        <view class="menu-badge neutral">清</view>
        <text>清空历史</text>
      </view>
      <view class="menu-item logout" bindtap="onLogout">
        <view class="menu-badge danger">退</view>
        <text>退出登录</text>
      </view>
    </view>
  </view>

  <view class="main">
    <view class="chat-topbar">
      <view class="icon-button" bindtap="toggleMenu">☰</view>
      <view class="topbar-copy">
        <text class="topbar-title">冰冰快答</text>
        <text class="topbar-subtitle">{{loading ? statusText : '随时提问'}}</text>
      </view>
    </view>

    <scroll-view class="message-list" scroll-y scroll-into-view="{{scrollToId}}" enhanced show-scrollbar="{{false}}">
      <view class="welcome-card" wx:if="{{messages.length === 0 && !loading}}">
        <view class="welcome-avatar">冰</view>
        <view class="welcome-copy">
          <text class="welcome-title">你好，我是新生助手</text>
          <text class="welcome-desc">{{welcomeText}}</text>
        </view>
      </view>

      <view
        class="message-row {{item.role === 'user' ? 'user' : ''}}"
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
      >
        <view class="message-avatar {{item.role}}">{{item.role === 'bot' ? '冰' : '我'}}</view>
        <view class="message-content">
          <view class="message-bubble {{item.role}}">
            <text user-select>{{item.text}}</text>
          </view>
          <view class="retry-chip" wx:if="{{item.failed}}" catchtap="onRetry" data-idx="{{index}}">重新提问</view>
          <text class="message-time">{{item.time}}</text>
          <view class="feedback-bar" wx:if="{{item.role === 'bot' && item.answerId && !item.rated && item.text.length > 5}}">
            <text class="feedback-label">有帮助吗？</text>
            <view class="feedback-option" catchtap="onFeedback" data-idx="{{index}}" data-score="1">有用</view>
            <view class="feedback-option negative" catchtap="onFeedback" data-idx="{{index}}" data-score="-1">需改进</view>
          </view>
        </view>
      </view>

      <view class="message-row" wx:if="{{loading}}" id="msg-loading">
        <view class="message-avatar bot">冰</view>
        <view class="message-content">
          <view class="message-bubble bot loading-bubble">
            <view class="loading-dots">
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
            <text class="loading-text">{{statusText}}</text>
          </view>
        </view>
      </view>
      <view id="msg-bottom" class="list-end"></view>
    </scroll-view>

    <view class="quick-bar">
      <scroll-view class="quick-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view
          class="quick-chip"
          wx:for="{{quickQuestions}}"
          wx:key="*this"
          bindtap="onQuickAsk"
          data-text="{{item}}"
        >{{item}}</view>
      </scroll-view>
    </view>

    <view class="input-bar">
      <view class="map-button" bindtap="openMap">图</view>
      <input
        class="question-input"
        placeholder="输入你的问题..."
        placeholder-class="input-placeholder"
        value="{{inputValue}}"
        bindinput="onInput"
        bindconfirm="onSend"
        confirm-type="send"
      />
      <view class="send-button {{inputValue ? 'active' : ''}}" bindtap="onSend">发送</view>
    </view>
  </view>
</view>
