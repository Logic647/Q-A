.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: calc(76rpx + env(safe-area-inset-top)) 22rpx 18rpx;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1rpx solid var(--line);
}

.header-left,
.header-right {
  width: 68rpx;
  height: 68rpx;
}

.header-left {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--surface-muted);
}

.header-left:active {
  opacity: 0.75;
}

.back-icon {
  color: var(--ink-secondary);
  font-size: 34rpx;
}

.header-title {
  color: var(--ink);
  font-size: 33rpx;
  font-weight: 700;
}

.content {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx;
}

.status-card {
  margin-top: 8rpx;
  padding: 48rpx 34rpx;
  text-align: center;
  background: var(--surface);
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}

.status-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  border-radius: 16rpx;
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
}

.status-icon.success { background: var(--success); }
.status-icon.warning { background: var(--warning); }

.status-text {
  display: block;
  margin-bottom: 10rpx;
  font-size: 33rpx;
  font-weight: 700;
}

.status-sub {
  display: block;
  color: var(--ink-muted);
  font-size: 25rpx;
  line-height: 1.5;
}

.form-card {
  margin-top: 8rpx;
  padding: 30rpx;
  background: var(--surface);
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}

.form-title {
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.form-desc {
  margin-bottom: 30rpx;
  color: var(--ink-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  display: block;
  margin-bottom: 11rpx;
  color: var(--ink-secondary);
  font-size: 25rpx;
  font-weight: 600;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 23rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fbfcfd;
  font-size: 28rpx;
}

.upload-area {
  width: 100%;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed #c9d3d6;
  border-radius: 14rpx;
  background: #fbfcfd;
}

.upload-area:active {
  background: var(--primary-soft);
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 36rpx;
  font-weight: 600;
}

.upload-text {
  max-width: 420rpx;
  color: var(--ink-muted);
  font-size: 24rpx;
  line-height: 1.45;
  text-align: center;
}

.submit-btn {
  height: 88rpx;
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #e7eaee;
  color: #a1a7af;
  font-size: 30rpx;
  font-weight: 600;
}

.submit-btn.active {
  background: var(--primary);
  color: #fff;
}
