.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.content {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx;
}

.status-card {
  margin-top: 8rpx;
  padding: 48rpx 34rpx;
  text-align: center;
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.status-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
  border-radius: var(--radius);
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
}

.status-icon.success { background: var(--success); }
.status-icon.warning { background: var(--warning); }

.status-text {
  display: block;
  margin-bottom: 10rpx;
  font-size: var(--font-lg);
  font-weight: 700;
}

.status-sub {
  display: block;
  color: var(--ink-muted);
  font-size: var(--font-sm);
  line-height: 1.5;
}

.form-card {
  margin-top: 8rpx;
  padding: 30rpx;
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--shadow-sm);
}

.form-title {
  margin-bottom: 8rpx;
  font-size: var(--font-lg);
  font-weight: 700;
}

.form-desc {
  margin-bottom: 30rpx;
  color: var(--ink-muted);
  font-size: var(--font-sm);
  line-height: 1.55;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  display: block;
  margin-bottom: 11rpx;
  color: var(--ink-secondary);
  font-size: var(--font-sm);
  font-weight: 600;
}

.form-input {
  width: 100%;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-sm);
  background: var(--bg);
  font-size: var(--font-md);
  transition: border-color 0.15s var(--ease);
}

.input-error {
  border-color: var(--danger);
}

.field-error {
  margin-top: 8rpx;
  color: var(--danger);
  font-size: var(--font-xs);
}

.upload-area {
  width: 100%;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx dashed var(--line);
  border-radius: var(--radius-sm);
  background: var(--bg);
  transition: background 0.15s var(--ease);
}

.upload-area:active {
  background: var(--primary-soft);
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 36rpx;
  font-weight: 600;
}

.upload-text {
  max-width: 420rpx;
  color: var(--ink-muted);
  font-size: var(--font-sm);
  line-height: 1.45;
  text-align: center;
}

.submit-btn {
  height: 88rpx;
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  font-size: 30rpx;
  font-weight: 600;
}
