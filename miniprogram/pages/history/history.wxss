.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: calc(76rpx + env(safe-area-inset-top)) 22rpx 18rpx;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1rpx solid var(--line);
}

.header-left,
.header-right {
  width: 68rpx;
  height: 68rpx;
}

.header-left {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--surface-muted);
}

.back-icon {
  color: var(--ink-secondary);
  font-size: 34rpx;
}

.header-title {
  color: var(--ink);
  font-size: 33rpx;
  font-weight: 700;
}

.content {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx 22rpx 40rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  text-align: center;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  background: var(--surface-muted);
  color: var(--ink-muted);
  font-size: 36rpx;
  font-weight: 700;
}

.empty-text {
  color: var(--ink-muted);
  font-size: 28rpx;
}

.history-card {
  padding: 25rpx;
  margin-bottom: 15rpx;
  background: var(--surface);
  border-radius: 14rpx;
  box-shadow: var(--shadow-sm);
}

.history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 13rpx;
}

.history-category {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 7rpx 15rpx;
  border-radius: 999rpx;
  background: var(--surface-muted);
  color: var(--ink-secondary);
  font-size: 21rpx;
}

.history-status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.history-status.done {
  background: var(--success-soft);
  color: var(--success);
}

.history-status.pending {
  background: var(--warning-soft);
  color: var(--warning);
}

.history-question {
  display: block;
  margin-bottom: 10rpx;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.5;
}

.history-answer {
  display: block;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
  color: var(--ink-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}
