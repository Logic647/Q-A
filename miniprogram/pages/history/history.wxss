.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.content {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 24rpx 22rpx 40rpx;
}

.skel-line {
  height: 26rpx;
  margin-bottom: 16rpx;
}

.skel-line.w50 { width: 50%; }
.skel-line.w90 { width: 90%; }
.skel-line.w70 { width: 70%; margin-bottom: 0; }

.retry-btn {
  margin-top: 28rpx;
  padding: 0 48rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  border-radius: var(--radius-pill);
  font-size: var(--font-sm);
}

.history-card {
  padding: 25rpx;
  margin-bottom: 15rpx;
  background: var(--surface);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
}

.history-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 13rpx;
}

.history-category {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 7rpx 15rpx;
  border-radius: var(--radius-pill);
  background: var(--surface-muted);
  color: var(--ink-secondary);
  font-size: 21rpx;
}

.history-status {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 21rpx;
  font-weight: 600;
}

.history-status.done {
  background: var(--success-soft);
  color: var(--success);
}

.history-status.pending {
  background: var(--warning-soft);
  color: var(--warning);
}

.history-question {
  display: block;
  margin-bottom: 10rpx;
  color: var(--ink);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.5;
}

.history-answer {
  display: block;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
  color: var(--ink-secondary);
  font-size: var(--font-sm);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
}

.history-answer.expanded {
  -webkit-line-clamp: unset;
}

.expand-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--primary-strong);
  font-size: var(--font-xs);
}
