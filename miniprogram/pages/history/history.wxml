<view class="page">
  <scroll-view class="content" scroll-y>
    <!-- 加载骨架 -->
    <block wx:if="{{loading}}">
      <view class="history-card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
        <view class="skel skel-line w50"></view>
        <view class="skel skel-line w90"></view>
        <view class="skel skel-line w70"></view>
      </view>
    </block>

    <!-- 加载失败 -->
    <view class="empty-state" wx:elif="{{loadError}}">
      <view class="empty-icon">!</view>
      <text class="empty-title">加载失败</text>
      <text class="empty-text">{{loadError}}</text>
      <view class="btn-main retry-btn" bindtap="loadHistory">重新加载</view>
    </view>

    <view class="empty-state" wx:elif="{{history.length === 0}}">
      <view class="empty-icon">空</view>
      <text class="empty-title">暂无提问记录</text>
      <text class="empty-text">在聊天页提出的问题会记录在这里</text>
    </view>

    <block wx:else>
      <view class="history-card" wx:for="{{history}}" wx:key="question_id">
        <view class="history-top">
          <text class="history-category">{{item.category || '未分类'}}</text>
          <text class="history-status {{item.status === 1 ? 'done' : 'pending'}}">
            {{item.status === 1 ? '已回答' : '待回答'}}
          </text>
        </view>
        <text class="history-question">{{item.question_text}}</text>
        <text wx:if="{{item.answer_text}}"
              class="history-answer {{expandedId === item.question_id ? 'expanded' : ''}}"
              bindtap="toggleExpand" data-id="{{item.question_id}}">{{item.answer_text}}</text>
        <text wx:if="{{item.answer_text && answerLong[item.question_id]}}" class="expand-hint">
          {{expandedId === item.question_id ? '收起' : '展开全文'}}
        </text>
      </view>
    </block>
  </scroll-view>
</view>
