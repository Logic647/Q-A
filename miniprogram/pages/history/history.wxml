<view class="page">
  <view class="header">
    <view class="header-left" bindtap="goBack"><text class="back-icon">←</text></view>
    <view class="header-title">提问记录</view>
    <view class="header-right"></view>
  </view>

  <scroll-view class="content" scroll-y>
    <view class="empty-state" wx:if="{{history.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无提问记录</text>
    </view>

    <view class="history-card" wx:for="{{history}}" wx:key="question_id">
      <view class="history-top">
        <text class="history-category">{{item.category || '未分类'}}</text>
        <text class="history-status {{item.status === 1 ? 'done' : 'pending'}}">
          {{item.status === 1 ? '已回答' : '待回答'}}
        </text>
      </view>
      <text class="history-question">{{item.question_text}}</text>
      <text class="history-answer" wx:if="{{item.answer_text}}">{{item.answer_text}}</text>
    </view>
  </scroll-view>
</view>
