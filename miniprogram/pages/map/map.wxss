.map-container {
  width: 100%;
  height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.map-scroll {
  flex: 1;
  overflow: hidden;
}

.campus-map-image {
  width: 100%;
  display: block;
}

.map-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.tip-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #999;
}
