.map-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--mask);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  height: 64vh;
  background: var(--surface);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 28rpx rgba(15, 42, 40, 0.14);
}

.drag-handle {
  display: flex;
  justify-content: center;
  padding: 15rpx 0 5rpx;
}

.drag-bar {
  width: 62rpx;
  height: 7rpx;
  border-radius: var(--radius-pill);
  background: var(--line);
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 26rpx 18rpx;
}

.sheet-title {
  color: var(--ink);
  font-size: 32rpx;
  font-weight: 700;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-muted);
  color: var(--ink-secondary);
  font-size: 34rpx;
}

.close-btn:active {
  opacity: 0.72;
}

.map-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 0 18rpx calc(18rpx + env(safe-area-inset-bottom));
}

.map-img {
  width: 100%;
  flex: 1;
  min-height: 0;
  border-radius: var(--radius-sm);
  background: var(--surface-muted);
}

.zoom-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding-top: 13rpx;
}

.zoom-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary-strong);
  font-size: 20rpx;
  font-weight: 700;
}

.zoom-text {
  color: var(--ink-muted);
  font-size: 22rpx;
}
