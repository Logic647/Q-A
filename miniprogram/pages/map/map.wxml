<view class="map-page">
  <view class="backdrop" bindtap="onClose"></view>
  <view class="sheet">
    <view class="drag-handle"><view class="drag-bar"></view></view>
    <view class="sheet-header">
      <text class="sheet-title">校园地图</text>
      <view class="close-btn" bindtap="onClose">×</view>
    </view>
    <view class="map-body" bindtap="onPreview">
      <image class="map-img" src="{{mapUrl}}" mode="aspectFit" show-menu-by-longpress />
      <view class="zoom-hint">
        <text class="zoom-icon">👆</text>
        <text class="zoom-text">点击查看大图（支持缩放）</text>
      </view>
    </view>
  </view>
</view>
