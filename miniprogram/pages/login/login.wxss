.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 72rpx 44rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg);
}

.hero {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 36rpx 34rpx;
  background: var(--surface);
  border: 1rpx solid rgba(229, 234, 236, 0.9);
  border-radius: 16rpx;
  box-shadow: var(--shadow-md);
}

.brand-mark {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 16rpx;
  background: var(--primary);
  color: #fff;
  font-size: 54rpx;
  font-weight: 700;
}

.brand-copy {
  min-width: 0;
}

.brand-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 700;
}

.brand-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-muted);
  font-size: 25rpx;
}

.feature-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 28rpx;
}

.feature {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  padding: 22rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}

.feature-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 12rpx;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
}

.feature-icon.primary { background: var(--primary); }
.feature-icon.green { background: var(--success); }

.feature-title {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
}

.feature-desc {
  display: block;
  margin-top: 4rpx;
  color: var(--ink-muted);
  font-size: 21rpx;
}

.action-card {
  margin-top: auto;
  padding: 42rpx 34rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}

.login-button,
.retry-button {
  height: 94rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: var(--primary);
  color: #fff;
  font-size: 31rpx;
  font-weight: 600;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.retry-button {
  background: var(--ink);
}

.login-button:active,
.retry-button:active {
  opacity: 0.88;
  transform: scale(0.99);
}

.action-note {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  color: var(--ink-muted);
  font-size: 23rpx;
}

.state-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  min-height: 94rpx;
}

.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--primary-soft);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  color: var(--ink-secondary);
  font-size: 28rpx;
}

.error-box {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.footer {
  padding-top: 38rpx;
  text-align: center;
  color: var(--ink-muted);
  font-size: 22rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
