<view class="page">
  <view class="hero">
    <view class="brand-mark">冰</view>
    <view class="brand-copy">
      <text class="brand-title">冰冰快答小助手</text>
      <text class="brand-subtitle">新生问题，一问即答</text>
    </view>
  </view>

  <view class="feature-panel">
    <view class="feature">
      <view class="feature-icon primary">问</view>
      <view class="feature-copy">
        <text class="feature-title">智能问答</text>
        <text class="feature-desc">校园信息快速检索</text>
      </view>
    </view>
    <view class="feature">
      <view class="feature-icon green">答</view>
      <view class="feature-copy">
        <text class="feature-title">同学互助</text>
        <text class="feature-desc">认证学生参与回答</text>
      </view>
    </view>
  </view>

  <view class="action-card">
    <block wx:if="{{!loading && !error}}">
      <view class="login-button" bindtap="onWxLogin">微信快捷登录</view>
      <text class="action-note">使用微信身份进入，无需重复注册</text>
    </block>

    <block wx:if="{{loading}}">
      <view class="state-row">
        <view class="spinner"></view>
        <text class="loading-text">正在安全登录</text>
      </view>
    </block>

    <block wx:if="{{error}}">
      <view class="error-box">{{error}}</view>
      <view class="retry-button" bindtap="onWxLogin">重新尝试</view>
    </block>
  </view>

  <view class="footer">
    <text>登录即表示同意相关服务协议</text>
  </view>
</view>
