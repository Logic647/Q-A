.admin-container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.admin-header {
  text-align: center;
  padding: 20rpx 0;
}

.admin-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.stats-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.stats-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #666;
  margin-top: 8rpx;
  display: block;
}

.section-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.section-count {
  color: #999;
  font-size: 24rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  padding: 40rpx;
  font-size: 26rpx;
}

.pending-item, .low-score-item, .kb-item {
  border-bottom: 1rpx solid #eee;
  padding: 16rpx 0;
}

.pending-item:last-child, .low-score-item:last-child, .kb-item:last-child {
  border-bottom: none;
}

.pending-header, .low-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.pending-q, .low-q {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  flex: 1;
}

.pending-category, .low-score {
  font-size: 22rpx;
  color: #999;
}

.pending-answer, .low-answer, .kb-answer {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.pending-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.pending-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.btn-pass {
  background: #22c55e !important;
  color: #fff !important;
  font-size: 24rpx;
}

.btn-reject {
  background: #ef4444 !important;
  color: #fff !important;
  font-size: 24rpx;
}

.btn-add {
  background: #333 !important;
  color: #fff !important;
  font-size: 24rpx;
}

.kb-question {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.kb-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.kb-category {
  font-size: 22rpx;
  color: #555;
  background: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.kb-hit {
  font-size: 22rpx;
  color: #999;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 99;
}

.modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.modal.show {
  transform: translateY(0);
}

.modal-header {
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
}

.form-textarea {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
  height: 200rpx;
  width: 100%;
  box-sizing: border-box;
}

.picker-text {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
}

.btn-submit {
  margin-top: 24rpx;
  background: #333 !important;
  color: #fff !important;
}
