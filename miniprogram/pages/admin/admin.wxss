.page { height: 100vh; display: flex; flex-direction: column; background: #fafafa; }
.header { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 24rpx; background: #fff; border-bottom: 1rpx solid #f0f0f0; flex-shrink: 0; z-index: 10; }
.header-left { padding: 12rpx; }
.back-icon { font-size: 36rpx; color: #333; }
.header-title { font-size: 34rpx; font-weight: 600; color: #111; }
.header-right { width: 64rpx; }
.tabs { display: flex; background: #fff; border-bottom: 1rpx solid #f0f0f0; flex-shrink: 0; }
.tab { flex: 1; text-align: center; padding: 22rpx 0; font-size: 26rpx; color: #999; position: relative; }
.tab.active { color: #111; font-weight: 600; }
.tab.active::after { content: ''; position: absolute; bottom: 0; left: 20%; right: 20%; height: 4rpx; background: #333; border-radius: 2rpx; }
.content { flex: 1; padding: 0 24rpx 24rpx; overflow-y: auto; }

.stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 20rpx; }
.stat-card { background: #fff; border-radius: 14rpx; padding: 24rpx; text-align: center; }
.stat-card.warn { background: #fffbeb; }
.stat-num { font-size: 48rpx; font-weight: bold; color: #111; display: block; }
.stat-card.warn .stat-num { color: #d97706; }
.stat-label { font-size: 24rpx; color: #666; display: block; margin-top: 4rpx; }
.stat-sub { font-size: 20rpx; color: #bbb; display: block; margin-top: 6rpx; }

.quick-stats { display: flex; background: #fff; border-radius: 14rpx; padding: 24rpx; margin-top: 16rpx; }
.qs-item { flex: 1; text-align: center; }
.qs-num { font-size: 36rpx; font-weight: 600; color: #333; display: block; }
.qs-label { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }

.section-card { background: #fff; border-radius: 14rpx; padding: 24rpx; margin-top: 16rpx; }
.section-title { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; font-weight: 600; color: #111; margin-bottom: 16rpx; }
.add-btn { font-size: 24rpx; color: #333; background: #f5f5f5; padding: 8rpx 24rpx; border-radius: 8rpx; font-weight: 500; }
.empty-tip { text-align: center; color: #ccc; padding: 40rpx; font-size: 26rpx; }

.item-card { border-bottom: 1rpx solid #f5f5f5; padding: 20rpx 0; }
.item-card:last-child { border-bottom: none; }
.item-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.item-name { font-size: 28rpx; color: #111; font-weight: 500; }
.item-id { font-size: 22rpx; color: #999; }
.item-category { font-size: 22rpx; color: #555; background: #f5f5f5; padding: 4rpx 12rpx; border-radius: 6rpx; }
.item-time { font-size: 22rpx; color: #bbb; }
.item-score { font-size: 22rpx; color: #d97706; }
.item-q { font-size: 26rpx; color: #333; font-weight: 500; display: block; margin-bottom: 4rpx; }
.item-a { font-size: 24rpx; color: #666; display: block; margin-bottom: 4rpx; line-height: 1.5; }
.item-sub { font-size: 22rpx; color: #bbb; display: block; margin-bottom: 6rpx; }
.item-actions { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 8rpx; }
.action-btn { padding: 10rpx 28rpx; border-radius: 8rpx; font-size: 24rpx; font-weight: 500; }
.action-btn.pass { background: #f0f7f0; color: #16a34a; }
.action-btn.reject { background: #fef2f2; color: #dc2626; }
.action-btn.edit { background: #f5f5f5; color: #555; }
.action-btn.reset { background: #fffbeb; color: #d97706; }

.remark-input { border: 1rpx solid #e5e7eb; border-radius: 8rpx; padding: 12rpx 16rpx; font-size: 24rpx; margin: 8rpx 0; width: 100%; box-sizing: border-box; }

.verify-img { width: 100%; max-height: 360rpx; border-radius: 10rpx; margin: 10rpx 0; display: block; }

.kb-item { border-bottom: 1rpx solid #f5f5f5; padding: 18rpx 0; }
.kb-item:last-child { border-bottom: none; }
.kb-header { display: flex; justify-content: space-between; margin-bottom: 6rpx; }
.kb-cat { font-size: 22rpx; color: #555; background: #f5f5f5; padding: 3rpx 10rpx; border-radius: 6rpx; }
.kb-hit { font-size: 20rpx; color: #bbb; }
.kb-q { font-size: 26rpx; color: #111; font-weight: 500; display: block; margin-bottom: 4rpx; }
.kb-a { font-size: 24rpx; color: #666; display: block; margin-bottom: 8rpx; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.kb-actions { display: flex; justify-content: flex-end; gap: 12rpx; }
.action-btn-sm { padding: 6rpx 20rpx; border-radius: 6rpx; font-size: 22rpx; }
.action-btn-sm.edit { background: #f5f5f5; color: #555; }
.action-btn-sm.del { background: #fef2f2; color: #dc2626; }

.modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 99; }
.kb-modal { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 20rpx 20rpx 0 0; z-index: 100; transform: translateY(100%); transition: transform 0.3s; }
.kb-modal.show { transform: translateY(0); }
.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 32rpx; border-bottom: 1rpx solid #f0f0f0; }
.modal-title { font-size: 32rpx; font-weight: 600; color: #111; }
.modal-close { font-size: 40rpx; color: #999; padding: 8rpx; }
.modal-body { padding: 24rpx 32rpx 40rpx; }
.form-item { margin-bottom: 24rpx; }
.form-label { font-size: 26rpx; color: #333; font-weight: 500; margin-bottom: 10rpx; display: block; }
.form-input { border: 1rpx solid #e5e7eb; border-radius: 10rpx; padding: 18rpx; font-size: 28rpx; width: 100%; box-sizing: border-box; }
.form-textarea { border: 1rpx solid #e5e7eb; border-radius: 10rpx; padding: 18rpx; font-size: 28rpx; height: 160rpx; width: 100%; box-sizing: border-box; }
.picker-val { border: 1rpx solid #e5e7eb; border-radius: 10rpx; padding: 18rpx; font-size: 28rpx; color: #333; }
.modal-btns { display: flex; gap: 20rpx; margin-top: 24rpx; }
.mbtn { flex: 1; height: 80rpx; line-height: 80rpx; text-align: center; border-radius: 10rpx; font-size: 28rpx; font-weight: 500; }
.mbtn.cancel { background: #f5f5f5; color: #666; }
.mbtn.confirm { background: #111; color: #fff; }
